# Database and private file storage
DATABASE_URL="file:./data/app.db"
STORAGE_ROOT="./storage"

# AI providers. OCR, vision, and text analysis can use independent OpenAI-compatible services.
# OPENAI_* remains as a shared fallback for single-provider deployments.
MOCK_MODE="true"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OCR_API_KEY=""
OCR_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
OCR_MODEL="qwen3.5-ocr"
VISION_PROVIDER="openai-compatible"
VISION_API_KEY=""
VISION_BASE_URL="https://api.deepseek.com"
VISION_MODEL="deepseek-flash"
# VISION_PROVIDER="doubao"
# DOUBAO_API_KEY=""
# DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# DOUBAO_VISION_MODEL=""
TEXT_API_KEY=""
TEXT_BASE_URL="https://api.deepseek.com"
TEXT_MODEL="deepseek-flash"
AI_NODE_MAX_ATTEMPTS="3"
AI_PAGE_CONCURRENCY="2"
AI_INSPECTION_NODE_CONCURRENCY="1"
IMAGE_PREPROCESS_CONCURRENCY="1"
AI_EXTRACTION_PAGE_BATCH_SIZE="2"
# OCR 版面解析输出上限：宽幅合页答题卡文本量大，给足以免 JSON 被截断
AI_OCR_LAYOUT_MAX_TOKENS="16384"
AI_EVALUATION_VISUAL_BATCH_SIZE="1"
AI_TEACHER_MARK_BATCH_SIZE="1"
TEACHER_MARK_RED_PIXEL_RATIO="0.0002"
AI_TEXT_CONCURRENCY="2"
AI_OCR_CACHE_ENTRIES="2"
AI_QUESTION_IMAGE_MAX_WIDTH="1400"
AI_QUESTION_IMAGE_MAX_HEIGHT="1800"
AI_QUESTION_CHUNK_SIZE="30"
AI_JOB_HEARTBEAT_MS="30000"
JOB_STALE_AFTER_MS="600000"
AI_REQUEST_TIMEOUT_MS="90000"
AI_INSPECTION_TIMEOUT_MS="12000"
OCR_REQUEST_TIMEOUT_MS="180000"

# PDF renderer
APP_BASE_URL="http://127.0.0.1:3000"
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""
MAX_UPLOAD_MB="15"
